# Config do Firebase gerada pelo `flutterfire configure`.
# Mesmo tipo de vazamento que o src/firebase.js da versao React.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
lib/firebase_options.dart

# Assinatura de release do Android
android/key.properties
*.jks
*.keystore
# Excecao consciente: o keystore de DEBUG e compartilhado de proposito.
# Ele assina apenas build de desenvolvimento, nao publica nada, e a senha
# `android` e a convencao documentada do Android. Sem um debug keystore unico,
# cada pessoa do grupo teria um SHA-1 diferente e o login quebraria para quem
# nao estivesse na lista da chave de API. O de RELEASE segue fora do repo.
!android/keystore/debug.jks

# Variaveis de ambiente
.env
.env.*
!.env.example
env.json
!env.example.json

# Backups que escapam do padrao original (ver vault: gitignore casa nome, nao conteudo)
*.bak
*.old
*-antigo

# Sessao do compilador Kotlin: o Gradle cria enquanto builda e some depois.
# Entrou num commit por acidente em 09/09 justamente porque um `flutter run`
# estava rodando na hora do `git add -A`.
android/.kotlin/

